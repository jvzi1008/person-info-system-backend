<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.compare.mapper.BizIpAuthMapper">

    <resultMap type="com.ruoyi.compare.domain.BizIpAuth" id="BizIpAuthResult">
        <id     property="id"            column="id"             />
        <result property="userId"        column="user_id"        />
        <result property="ipAddress"     column="ip_address"     />
        <result property="sourceType"    column="source_type"    />
        <result property="authType"      column="auth_type"      />
        <result property="status"        column="status"         />
        <result property="auditStatus"   column="audit_status"   />
        <result property="auditBy"       column="audit_by"       />
        <result property="auditTime"     column="audit_time"     />
        <result property="auditRemark"   column="audit_remark"   />
        <result property="effectiveTime" column="effective_time" />
        <result property="expireTime"    column="expire_time"    />
        <result property="maxQps"        column="max_qps"        />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectBizIpAuthVo">
        select id, user_id, ip_address, source_type, auth_type, status,
               audit_status, audit_by, audit_time, audit_remark,
               effective_time, expire_time, max_qps, create_by, create_time,
               update_by, update_time, remark
        from biz_ip_auth
    </sql>

    <select id="selectBizIpAuthById" parameterType="Long" resultMap="BizIpAuthResult">
        <include refid="selectBizIpAuthVo"/>
        where id = #{id}
    </select>

    <select id="selectBizIpAuthList" parameterType="com.ruoyi.compare.domain.BizIpAuth" resultMap="BizIpAuthResult">
        <include refid="selectBizIpAuthVo"/>
        <where>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="ipAddress != null and ipAddress != ''">
                and ip_address = #{ipAddress}
            </if>
            <if test="sourceType != null and sourceType != ''">
                and source_type = #{sourceType}
            </if>
            <if test="authType != null and authType != ''">
                and auth_type = #{authType}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="auditStatus != null and auditStatus != ''">
                and audit_status = #{auditStatus}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectActiveByUserId" parameterType="Long" resultMap="BizIpAuthResult">
        <include refid="selectBizIpAuthVo"/>
        where user_id = #{userId}
          and status = '0'
          and audit_status = '1'
          and (effective_time is null or effective_time &lt;= now())
          and (expire_time is null or expire_time &gt;= now())
        order by id
    </select>

    <select id="selectByUserIdAndIp" resultMap="BizIpAuthResult">
        <include refid="selectBizIpAuthVo"/>
        where user_id = #{userId}
          and ip_address = #{ipAddress}
        limit 1
    </select>

    <insert id="insertBizIpAuth" parameterType="com.ruoyi.compare.domain.BizIpAuth" useGeneratedKeys="true" keyProperty="id">
        insert into biz_ip_auth (
            user_id, ip_address, source_type, auth_type, status,
            audit_status, audit_by, audit_time, audit_remark,
            effective_time, expire_time, max_qps, create_by, create_time, remark
        ) values (
            #{userId}, #{ipAddress}, #{sourceType}, #{authType}, #{status},
            #{auditStatus}, #{auditBy}, #{auditTime}, #{auditRemark},
            #{effectiveTime}, #{expireTime}, #{maxQps}, #{createBy}, #{createTime}, #{remark}
        )
    </insert>

    <update id="updateBizIpAuth" parameterType="com.ruoyi.compare.domain.BizIpAuth">
        update biz_ip_auth
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="ipAddress != null and ipAddress != ''">ip_address = #{ipAddress},</if>
            <if test="sourceType != null and sourceType != ''">source_type = #{sourceType},</if>
            <if test="authType != null and authType != ''">auth_type = #{authType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditStatus != null and auditStatus != ''">audit_status = #{auditStatus},</if>
            <if test="auditBy != null and auditBy != ''">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="effectiveTime != null">effective_time = #{effectiveTime},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="maxQps != null">max_qps = #{maxQps},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = #{updateTime}
        </set>
        where id = #{id}
    </update>

    <delete id="deleteBizIpAuthByIds" parameterType="Long">
        delete from biz_ip_auth where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteBizIpAuthByUserId" parameterType="Long">
        delete from biz_ip_auth where user_id = #{userId}
    </delete>

    <update id="disableByUserIds" parameterType="Long">
        update biz_ip_auth
        set status = '1'
        where user_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
